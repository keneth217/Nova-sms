# Backend environment (do not commit real secrets)

# Public API origin shown in developer documentation (no trailing slash)
NOVA_SMS_API_BASE_URL=https://smsapi.novastack.co.ke

# SMS provider: talksasa (default) | africastalking
SMS_PROVIDER=talksasa
SMS_BATCH_SIZE=100
SMS_PRICE_PER_UNIT=1.00
SMS_CURRENCY=KES
SMS_BILLING_CUSTOMER_PRICE=1.00
SMS_BILLING_PROVIDER_COST=0.35
SMS_BILLING_CURRENCY=KES
SMS_STATUS_SYNC_ENABLED=true
SMS_STATUS_SYNC_CRON=0 */5 * * * *

# TalkSasa Bulk SMS API v3 — never expose these to the frontend
TALKSASA_API_TOKEN=
TALKSASA_SENDER_ID=TALK-SASA
TALKSASA_BASE_URL=https://bulksms.talksasa.com/api/v3
TALKSASA_SYNC_CONTACT_GROUPS=true

# Optional WhatsApp unit price. When unset, the organization SMS cost is used.
# NOVASTACK_SMS_PRICING_WHATSAPP_PRICE_PER_UNIT=1.00

# Optional Africa's Talking fallback
AT_USERNAME=
AT_API_KEY=
AT_BASE_URL=https://api.africastalking.com
